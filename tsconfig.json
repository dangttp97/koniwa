{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "koniwa",
    "paths": {
      "koniwa": ["./src/index.ts"],
      "koniwa/jsx-runtime": ["./src/jsx-runtime.ts"],
      "koniwa/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test"]
}

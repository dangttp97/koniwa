{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@koniwa/core",
    "paths": {
      "@koniwa/core": ["./packages/core/src/index.ts"],
      "@koniwa/core/jsx-runtime": ["./packages/core/src/jsx-runtime.ts"],
      "@koniwa/core/jsx-dev-runtime": [
        "./packages/core/src/jsx-dev-runtime.ts"
      ],
      "@koniwa/router": ["./packages/router/src/index.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["packages/*/src", "packages/*/test", "vitest.config.ts"]
}

{
  "name": "koniwa-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -At run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
